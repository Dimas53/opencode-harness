#!/bin/bash
# .git/hooks/post-commit
# harness-managed-hook: v1
# Installed by: scripts/install-hooks.sh (also scripts/install.sh, update.sh)
#
# The `harness-managed-hook` line above is a signature, not a comment — see
# hooks/pre-commit for what reads it and why (T-I3).
#
# Two responsibilities:
# 1. DoD guard — verify the commit that just landed actually passes DoD.
#    Catches `git commit --no-verify` and any other pre-commit bypass. If it
#    fails, roll the commit back with `git reset --soft HEAD~1` (changes stay
#    staged, nothing is lost) and refuse silently-succeeding.
# 2. Mirror global/skills/ + global/AGENTS.md to ~/.config/opencode/ — but
#    ONLY when this commit actually touched them (not on every commit).
#
# Note: `git reset --soft` does not create a new commit, so it does not
# re-trigger this hook — no recursion risk.

HARNESS_ROOT="$(git rev-parse --show-toplevel)"
DOD_SCRIPT="${OPENCODE_HARNESS_PATH:-$HOME/.opencode-harness}/scripts/dod.sh"

# Did the pre-commit gate actually run — and pass — for the commit that just
# landed? Without this the guard infers "the gate was bypassed" from the proxy
# "DoD fails now", and that proxy lies whenever the two modes can disagree
# about the same commit (T-I27). Roll back only when there is NO trace of a
# recent passing pre-commit run; otherwise the disagreement is our bug, and
# rolling back a commit the gate explicitly approved is the worse failure.
gate_ran_and_passed() {
  local log="$HARNESS_ROOT/.dod-run.log"
  [ -f "$log" ] || return 1

  local last_pre
  last_pre=$(grep '|pre-commit|' "$log" 2>/dev/null | tail -1)
  [ -n "$last_pre" ] || return 1
  [ "${last_pre##*|}" = "pass" ] || return 1

  local stamp epoch now
  stamp="${last_pre%%|*}"
  if [[ "$OSTYPE" == "darwin"* ]]; then
    epoch=$(date -j -f "%Y-%m-%dT%H:%M:%S" "$stamp" +%s 2>/dev/null) || return 1
  else
    epoch=$(date -d "${stamp/T/ }" +%s 2>/dev/null) || return 1
  fi
  now=$(date +%s)
  [ $((now - epoch)) -le 120 ]
}

if [ -f "$DOD_SCRIPT" ]; then
  LOG="/tmp/harness-post-commit-dod-$$.log"
  # PRE_COMMIT=0 explicitly: this hook runs after the commit exists, so the
  # gate must judge it in manual mode. git never exports PRE_COMMIT here, but
  # a nested run (dod.sh -> make test-quick -> bats -> this hook) would
  # inherit it and silently flip the mode — the very ambiguity T-I27 is about.
  if ! PRE_COMMIT=0 bash "$DOD_SCRIPT" >"$LOG" 2>&1; then
    if gate_ran_and_passed; then
      echo "⚠ POST-COMMIT: DoD passes in pre-commit mode but fails now." >&2
      echo "  The pre-commit gate ran for this commit and approved it, so the" >&2
      echo "  commit is NOT being rolled back — the two verdicts disagreeing" >&2
      echo "  is a harness bug, not a bypass. Please report it." >&2
      echo "  Failing step(s):" >&2
      grep -E '^✗' "$LOG" | sed 's/^/    /' >&2
      echo "  Full DoD output: $LOG" >&2
      exit 0
    fi
    echo "✗ POST-COMMIT GUARD: the commit that just landed fails DoD," >&2
    echo "  and there is no record of the pre-commit gate passing for it." >&2
    echo "  Either --no-verify was used, or the hook is not installed" >&2
    echo "  (check .git/hooks/pre-commit), or the gate itself errored out." >&2
    echo "  Failing step(s):" >&2
    grep -E '^✗' "$LOG" | sed 's/^/    /' >&2
    echo "  Full DoD output: $LOG" >&2
    if git rev-parse HEAD~1 >/dev/null 2>&1; then
      git reset --soft HEAD~1
      echo "  Rolled back: git reset --soft HEAD~1 — your changes are still" >&2
      echo "  staged, nothing is lost. Fix the DoD failures, then commit again." >&2
    else
      echo "  This is the repo's initial commit — cannot auto-rollback." >&2
      echo "  Fix the DoD failures manually before continuing." >&2
    fi
    exit 1
  fi
  rm -f "$LOG"
fi

CHANGED=$(git diff --name-only HEAD~1 HEAD 2>/dev/null || true)
if echo "$CHANGED" | grep -qE "^global/(skills/|AGENTS\.md$)"; then
  mkdir -p ~/.config/opencode/skills
  # Exclusions live in one file for all three mirroring sites — see
  # scripts/mirror-excludes.txt for why (T-I13).
  rsync -a --exclude-from="$HARNESS_ROOT/scripts/mirror-excludes.txt" \
        "$HARNESS_ROOT/global/skills/." ~/.config/opencode/skills/
  STALE_SKILLS=$(comm -23 \
    <(find ~/.config/opencode/skills -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort) \
    <(find "$HARNESS_ROOT/global/skills" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort))
  if [ -n "$STALE_SKILLS" ]; then
    echo "⚠ Skills present in ~/.config/opencode/skills/ but no longer in global/skills/ (not removed automatically — review and delete manually if stale):" >&2
    echo "$STALE_SKILLS" | sed 's/^/    /' >&2
  fi
  cp "$HARNESS_ROOT/global/AGENTS.md" ~/.config/opencode/AGENTS.md
  echo "✓ Skills + AGENTS.md mirrored to ~/.config/opencode/ (global/ changed in this commit)"
fi
